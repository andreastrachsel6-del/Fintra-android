<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ONIA</title>
<link rel="manifest" href="manifest-onia.json">
<link rel="icon" type="image/png" href="icon-onia-192.png">
<link rel="apple-touch-icon" href="icon-onia-192.png">
<meta name="theme-color" content="#8A7350">
<meta name="application-name" content="ONIA">
<meta name="apple-mobile-web-app-title" content="ONIA">
<meta name="mobile-web-app-capable" content="yes">
<meta name="color-scheme" content="light dark">
<style>
:root{
  --bg:#EDF2F8; --surface:#FFFFFF; --ink:#0E2038; --muted:#5B6C83; --line:#D6E0EC;
  --blue:#1B62C4; --on-blue:#FFFFFF; --tint:#E2EDFA; --navy:#0B2A4A;
  --ok:#1B7F4F; --warn:#9A5B00; --warn-bg:#FFF3DB; --bad:#B8362B; --info-bg:#E2EDFA;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0A1322; --surface:#111E33; --ink:#E7EEF8; --muted:#93A5BF; --line:#22344F;
    --blue:#5AA0F5; --on-blue:#08192F; --tint:#15294A; --navy:#08111F;
    --ok:#53C28C; --warn:#F0B454; --warn-bg:#3A2E12; --bad:#FF8B7E; --info-bg:#15294A;
  }
}
:root[data-theme="dark"]{
  --bg:#0A1322; --surface:#111E33; --ink:#E7EEF8; --muted:#93A5BF; --line:#22344F;
  --blue:#5AA0F5; --on-blue:#08192F; --tint:#15294A; --navy:#08111F;
  --ok:#53C28C; --warn:#F0B454; --warn-bg:#3A2E12; --bad:#FF8B7E; --info-bg:#15294A;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;-webkit-tap-highlight-color:transparent}
button,input,select,textarea{font:inherit;color:inherit}
svg.ic{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.wrap{max-width:620px;margin:0 auto}

header.top{position:sticky;top:0;z-index:20;background:var(--navy);color:#fff;padding:calc(10px + env(safe-area-inset-top)) 16px 10px}
header.top .wrap{display:flex;align-items:center;gap:10px}
header.top img{width:36px;height:36px;border-radius:50%;display:block}
header.top b{font-size:21px;font-weight:700;letter-spacing:.2px}
header.top span{margin-left:auto;font-size:14px;opacity:.75}

main{padding:16px 16px calc(112px + env(safe-area-inset-bottom))}
body.formview main{padding-bottom:calc(96px + env(safe-area-inset-bottom))}
.loading{padding:60px 0;text-align:center;color:var(--muted)}

.search{position:relative}
.search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);width:20px;height:20px}
.search input{width:100%;min-height:48px;padding:0 14px 0 44px;border:1.5px solid var(--line);border-radius:14px;background:var(--surface);font-size:16px}
input:focus,select:focus,textarea:focus{outline:2px solid var(--blue);outline-offset:1px}
.count{margin:10px 2px 4px;font-size:14px;color:var(--muted)}

.row{display:grid;grid-template-columns:48px 1fr auto;gap:12px;align-items:center;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);padding:12px 2px;min-height:68px;cursor:pointer}
.row:active{background:var(--tint)}
.row .nm{font-weight:600;font-size:17px;line-height:1.25}
.row .sub{color:var(--muted);font-size:14px}
.av{display:inline-grid;place-items:center;border-radius:50%;background:hsl(var(--h) 46% 38%);color:#fff;font-weight:600;flex:none}
.pill{display:inline-block;min-width:24px;padding:2px 9px;border-radius:99px;background:var(--tint);color:var(--blue);font-size:13px;font-weight:600;text-align:center}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border-radius:12px;border:1.5px solid var(--blue);background:var(--blue);color:var(--on-blue);font-weight:600;cursor:pointer;text-decoration:none}
.btn:active{filter:brightness(.92)}
.btn[disabled]{opacity:.5;pointer-events:none}
.btn.ghost{background:transparent;color:var(--blue)}
.btn.quiet{background:transparent;border-color:transparent;color:var(--blue)}
.btn.danger{background:transparent;border-color:transparent;color:var(--bad)}
.btn.block{width:100%}
.link{background:none;border:0;padding:0;color:var(--blue);font-weight:600;text-decoration:underline;cursor:pointer}

.note{padding:12px 14px;border-radius:12px;background:var(--info-bg);font-size:15px;margin:0 0 14px}
.note.warn{background:var(--warn-bg);color:var(--warn)}
.note.warn .link{color:inherit}

.empty{padding:36px 8px;text-align:center;color:var(--muted)}
.empty h2{margin:0 0 6px;color:var(--ink);font-size:20px}
.empty .btns{display:flex;flex-direction:column;gap:10px;margin-top:18px}

.back{display:inline-flex;align-items:center;gap:4px;margin:-6px 0 8px -8px;padding:8px;background:none;border:0;color:var(--blue);font-weight:600;cursor:pointer}
.hero{display:flex;gap:14px;align-items:center;margin-bottom:14px}
.hero h1{margin:0;font-size:26px;line-height:1.15;font-weight:700}
.hero p{margin:2px 0 0;color:var(--muted)}
.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:6px}
.actions .btn{padding:0 8px;min-height:44px}

.sec{margin-top:22px;padding-top:14px;border-top:1px solid var(--line)}
.sec h2{margin:0 0 10px;font-size:17px;font-weight:700;color:var(--blue)}
.kv{display:grid;grid-template-columns:minmax(110px,38%) 1fr;gap:8px 12px;margin:0}
.kv dt{color:var(--muted);font-size:15px}
.kv dd{margin:0;font-weight:500;overflow-wrap:anywhere}
.kv a{color:var(--blue)}
.chip{display:inline-block;padding:2px 10px;border-radius:99px;font-size:14px;font-weight:600;background:var(--tint);color:var(--blue)}
.chip.ok{background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok)}
.muted{color:var(--muted)}.small{font-size:14px}
.notes{white-space:pre-wrap;margin:0}

.addtask{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:10px}
.addtask input[type=text]{grid-column:1/-1}
.addtask input,.fld input,.fld select,.fld textarea{width:100%;min-height:46px;padding:9px 12px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface)}
.task{display:grid;grid-template-columns:36px 1fr auto;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}
.task .t{font-weight:500}
.task.done .t{text-decoration:line-through;color:var(--muted)}
.task .d{font-size:14px;color:var(--muted)}
.task .d.late{color:var(--bad);font-weight:600}
.tick{width:30px;height:30px;border-radius:50%;border:2px solid var(--blue);background:transparent;color:var(--on-blue);display:grid;place-items:center;cursor:pointer;padding:0}
.task.done .tick{background:var(--blue)}
.tick svg{width:16px;height:16px;stroke-width:3}
.x{background:none;border:0;color:var(--muted);padding:8px;cursor:pointer}

.log{list-style:none;margin:0;padding:0 0 0 14px;border-left:2px solid var(--line)}
.log li{position:relative;padding:0 0 14px 12px}
.log li::before{content:"";position:absolute;left:-21px;top:6px;width:10px;height:10px;border-radius:50%;background:var(--blue)}
.log time{display:block;font-size:13px;color:var(--muted)}
.log p{margin:2px 0 0;white-space:pre-wrap;font-size:15px}

.tabs{display:flex;gap:6px;margin-bottom:8px}
.tab{flex:1;min-height:42px;border-radius:12px;border:1.5px solid var(--line);background:transparent;font-weight:600;color:var(--muted);cursor:pointer}
.tab.on{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
.ttitle{margin:0 0 12px;font-size:24px;font-weight:700}

.fld{margin-bottom:12px}
.fld label{display:block;margin:0 0 4px;font-size:14px;color:var(--muted);font-weight:500}
.fld textarea{min-height:110px;resize:vertical}
.fld.warn input,.fld.warn select{border-color:var(--warn);background:var(--warn-bg)}
.fld.warn label::after{content:" – bitte prüfen";color:var(--warn);font-weight:600}
.grid2{display:grid;grid-template-columns:110px 1fr;gap:10px}
.chk{display:flex;align-items:center;gap:12px;min-height:46px;margin-bottom:8px;font-weight:500}
.chk input{width:22px;height:22px;accent-color:var(--blue)}
.fsec{margin:22px 0 10px;padding-top:12px;border-top:1px solid var(--line);font-size:17px;font-weight:700;color:var(--blue)}
.fsec:first-of-type{margin-top:6px;border-top:0;padding-top:0}
.formbar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom))}
.formbar .wrap{display:grid;grid-template-columns:1fr 2fr;gap:10px}

.drop{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.thumb{position:relative;aspect-ratio:1;border-radius:12px;overflow:hidden;background:var(--tint)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb button{position:absolute;top:4px;right:4px;width:30px;height:30px;border-radius:50%;border:0;background:rgba(0,0,0,.65);color:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.thumb button svg{width:16px;height:16px}
.spin{display:inline-block;width:18px;height:18px;border:3px solid color-mix(in srgb,currentColor 30%,transparent);border-top-color:currentColor;border-radius:50%;animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion: reduce){.spin{animation-duration:2.4s}}
.err{color:var(--bad);font-weight:500;margin:10px 0}

nav.bar{position:fixed;left:0;right:0;bottom:0;z-index:25;background:var(--surface);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom))}
nav.bar .wrap{display:grid;grid-template-columns:repeat(4,1fr);align-items:end}
body.formview nav.bar{display:none}
nav.bar button{display:flex;flex-direction:column;align-items:center;gap:2px;min-height:54px;padding:6px 0;border:0;background:none;color:var(--muted);font-size:13px;font-weight:500;cursor:pointer}
nav.bar button.on{color:var(--blue);font-weight:700}
nav.bar button.cam .disc{display:grid;place-items:center;width:52px;height:52px;margin-top:-22px;border-radius:50%;background:var(--blue);color:var(--on-blue);box-shadow:0 4px 12px rgba(11,42,74,.35);border:3px solid var(--surface)}
nav.bar button.cam{color:var(--blue);font-weight:700;padding-top:0}

.toast{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:60;max-width:calc(100% - 32px);padding:10px 16px;border-radius:12px;background:var(--navy);color:#fff;font-size:15px;box-shadow:0 4px 16px rgba(0,0,0,.3)}
.ov{position:fixed;inset:0;z-index:70;background:rgba(5,12,24,.55);display:grid;place-items:end center;padding:16px}
.ov .box{width:100%;max-width:420px;background:var(--surface);border-radius:18px;padding:18px}
.ov .box p{margin:0 0 14px;font-size:17px;font-weight:500}
.ov .box .btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0 4px}
.tile{display:flex;flex-direction:column;gap:2px;text-align:left;padding:12px;border-radius:14px;border:1px solid var(--line);background:var(--surface);min-height:92px;color:var(--ink)}
button.tile{cursor:pointer}
button.tile:active{background:var(--tint)}
.tile .tl{font-size:13px;color:var(--muted);font-weight:500}
.tile .tv{font-size:18px;font-weight:700;line-height:1.2;overflow-wrap:anywhere}
.tile .ts{font-size:13px;color:var(--muted)}
.dtabs{position:sticky;top:calc(56px + env(safe-area-inset-top));z-index:15;background:var(--bg);display:flex;gap:6px;overflow-x:auto;margin:10px -16px 0;padding:8px 16px;scrollbar-width:none}
.dtabs::-webkit-scrollbar{display:none}
.dtabs button{flex:none;min-height:40px;padding:0 14px;border-radius:99px;border:1.5px solid var(--line);background:var(--surface);color:var(--muted);font-weight:600;cursor:pointer;white-space:nowrap}
.dtabs button.on{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
.irow{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);padding:12px 2px;cursor:pointer;color:var(--ink)}
.irow:active{background:var(--tint)}
.irow .it{display:block;font-weight:600}
.irow .is{display:block;font-size:14px;color:var(--muted)}
.irow .ir{font-weight:700;text-align:right;white-space:nowrap}
.irow .ir.late{color:var(--bad)}.irow .ir.soon{color:var(--warn)}
.irow .rel{font-weight:500;font-size:13px}
.irow .chip{margin-top:4px}
.sech{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.sech h2{margin:0!important}
.btn.sm{min-height:38px;padding:0 12px;font-size:15px}
.btnrow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.total{display:flex;justify-content:space-between;gap:10px;padding:12px 14px;border-radius:12px;background:var(--tint);font-weight:700;margin-top:10px}
.bigsum{font-size:32px;font-weight:700;line-height:1.15}
.stack{display:flex;height:12px;border-radius:99px;overflow:hidden;background:var(--line);margin:12px 0 8px}
.stack i{display:block;height:100%}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:14px;color:var(--muted)}
.legend b{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.chip.warn{background:var(--warn-bg);color:var(--warn)}
.chip.bad{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}
.letter textarea{width:100%;min-height:440px;padding:12px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);font:15px/1.5 ui-monospace,Menlo,Consolas,monospace}
#printarea{display:none}
@media print{body>*:not(#printarea){display:none!important}#printarea{display:block!important;white-space:pre-wrap;font:12pt/1.5 Georgia,serif;color:#000}}
.irow .chip,.kv .chip{border-radius:10px;line-height:1.3;padding:3px 10px}

.irow .chip,.kv .chip{border-radius:10px;line-height:1.3;padding:3px 10px}
.subh{font-size:15px;font-weight:700;color:var(--ink)}
.doc{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.doc.sel{grid-template-columns:auto auto 1fr auto}
.dchk{width:22px;height:22px;accent-color:var(--blue)}
.dthumb{width:52px;height:52px;border-radius:10px;overflow:hidden;background:var(--tint);border:1px solid var(--line);padding:0;display:grid;place-items:center;color:var(--blue);cursor:pointer;font-weight:700;font-size:13px}
.dthumb img{width:100%;height:100%;object-fit:cover;display:block}
.dmeta{min-width:0;text-align:left;background:none;border:0;padding:0;color:var(--ink);cursor:pointer}
.dmeta b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}
.dmeta span{font-size:13px;color:var(--muted)}
.dact{display:flex}
.docs-h{margin:16px 0 2px;font-size:14px;font-weight:700;color:var(--muted)}
.viewer{position:fixed;inset:0;z-index:80;background:rgba(5,12,24,.94);display:flex;flex-direction:column}
.viewer .vt{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:calc(10px + env(safe-area-inset-top)) 12px 10px;color:#fff}
.viewer .vb{flex:1;overflow:auto;-webkit-overflow-scrolling:touch}
.viewer img{width:100%;height:auto;display:block}
.viewer .btn{background:transparent;color:#fff;border-color:rgba(255,255,255,.6)}
.txt{width:100%;min-height:46px;padding:9px 12px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);margin-bottom:12px}
.dtabs{top:var(--hh,56px)!important}
nav.bar .wrap{grid-template-columns:repeat(5,1fr)}
nav.bar button{font-size:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
.pbtn{border:1px solid var(--line);cursor:pointer;background:var(--surface);color:var(--blue);font-weight:600}
.brow{display:grid;grid-template-columns:96px 1fr 28px;gap:8px;align-items:center;padding:4px 0}
.bbar{height:10px;border-radius:99px;background:var(--line);overflow:hidden}
.bbar i{display:block;height:100%;background:var(--blue);border-radius:99px}
.mrow{display:grid;grid-template-columns:1fr;gap:8px;padding:12px 0;border-bottom:1px solid var(--line)}
.mrow .dact{display:flex;gap:8px;flex-wrap:wrap}
.leadbar{margin-top:10px}
.pbrk{page-break-after:always}
@media print{.pbrk{white-space:pre-wrap;font:12pt/1.5 Georgia,serif;color:#000}}
</style>
</head>
<body>
<header class="top"><div class="wrap"><img alt="" src="data:image/png;base64,"><b>ONIA</b><span id="hcount"></span></div></header>
<main><div class="wrap" id="app"></div></main>
<nav class="bar"><div class="wrap" id="nav"></div></nav>
<div id="toast" class="toast" hidden></div>
<div id="printarea" aria-hidden="true"></div>

<script>
(() => {
'use strict';

/* ---------- Helfer ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad = n => String(n).padStart(2, '0');
const clone = o => JSON.parse(JSON.stringify(o));
const uid = () => 'k' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const norm = s => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
const isoToday = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; };
const isoTomorrow = () => { const d = new Date(); d.setDate(d.getDate()+1); return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; };
const fmtDate = iso => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || ''); return m ? `${m[3]}.${m[2]}.${m[1]}` : (iso || ''); };
const fmtTs = ts => { const d = new Date(ts); return `${pad(d.getDate())}.${pad(d.getMonth()+1)}.${String(d.getFullYear()).slice(2)} ${pad(d.getHours())}:${pad(d.getMinutes())}`; };
const ageOf = iso => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || ''); if (!m) return null; const n = new Date(); let a = n.getFullYear() - +m[1]; if (n.getMonth()+1 < +m[2] || (n.getMonth()+1 === +m[2] && n.getDate() < +m[3])) a--; return a >= 0 && a < 130 ? a : null; };
const hue = s => { let h = 0; for (const ch of String(s)) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return 190 + (h % 70); };
const fullName = c => [c.vorname, c.nachname].filter(Boolean).join(' ') || 'Ohne Name';

const P = d => `<svg class="ic" viewBox="0 0 24 24">${d}</svg>`;
const I = {
  users: P('<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.9c1.7.8 2.8 2.4 3 5.1"/>'),
  check: P('<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>'),
  cam: P('<path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'),
  more: P('<circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/>'),
  search: P('<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>'),
  back: P('<path d="M15 5l-7 7 7 7"/>'),
  chev: P('<path d="M9 5l7 7-7 7"/>'),
  phone: P('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>'),
  mail: P('<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>'),
  edit: P('<path d="M4 20h4L19 9l-4-4L4 16z"/>'),
  x: P('<path d="M6 6l12 12M18 6L6 18"/>'),
  plus: P('<path d="M12 5v14M5 12h14"/>'),
  tick: P('<path d="M5 12.5l4.5 4.5L19 7.5"/>'),
  gallery: P('<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l5-4.5 4 3.5 3-2.5 4 3.5"/>')
};

