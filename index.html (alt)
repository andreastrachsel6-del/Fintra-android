    if (match) {
      const d = clone(match);
      for (const k of TEXT_KEYS) {
        if (!ex[k]) continue;
        if (k === 'notizen') { if (!(d.notizen || '').includes(ex.notizen)) d.notizen = [d.notizen, ex.notizen].filter(Boolean).join('\n'); }
        else d[k] = ex[k];
      }
      startForm(match.id, d, 'foto', uns, match.id);
    } else startForm(null, ex, 'foto', uns, null);
  } catch (e) {
    S.busy = false;
    if (!e || e.code !== 'cancelled') S.err = SAMPLE_ERR[e && e.code] || 'Verbindungsproblem. Versuche es noch einmal.';
    render();
  }
}

/* ---------- Export / Import ---------- */
const today = () => isoToday();
function saveFile(name, data, type) {
  const u = URL.createObjectURL(new Blob([data], { type }));
  const a = document.createElement('a'); a.href = u; a.download = name; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(u), 5000);
  if (/\.(json|zip)$/i.test(name)) { ls.set(LB, String(Date.now())); }
  toast('Datei wird gespeichert');
}
function csv() {
  const cols = ALL.filter(f => f.k !== 'notizen');
  const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
  const head = [...cols.map(f => f.l), 'Notizen', 'Offene Aufgaben'];
  const rows = S.customers.map(c => [...cols.map(f => f.t === 'check' ? (c[f.k] ? 'Ja' : 'Nein') : (f.k === 'geburtsdatum' ? fmtDate(c[f.k]) : c[f.k])), c.notizen, openTasks(c).length]);
  return '\ufeff' + [head, ...rows].map(r => r.map(q).join(';')).join('\r\n');
}
async function importData(j) {
  const list = Array.isArray(j) ? j : (Array.isArray(j.kunden) ? j.kunden : []);
  let n = 0;
  for (const raw of list) {
    if (!raw || typeof raw !== 'object' || !raw.id) continue;
    const c = normC(raw); const cur = byId(c.id);
    if (cur && (cur.geaendert || 0) >= (c.geaendert || 0)) continue;
    await saveCustomer(c); n++;
  }
  return n;
}
async function importFile(file) {
  try {
    if (/\.zip$/i.test(file.name || '')) { const r = await importZip(file); toast(r.n || r.nd ? `${r.n} Kunden und ${r.nd} Dokumente übernommen` : 'Nichts Neues im Backup'); }
    else { const n = await importData(JSON.parse(await file.text())); toast(n ? `${n} Kunden übernommen` : 'Nichts Neues im Backup'); }
    render();
  } catch (e) { toast('Die Datei konnte nicht gelesen werden.'); }
}

/* ---------- Ereignisse ---------- */
document.addEventListener('click', async e => {
  const t = e.target.closest('[data-act]'); if (!t) return;
  const a = t.dataset.act, id = t.dataset.id;
  switch (a) {
    case 'tab': go(t.dataset.view); break;
    case 'open': S.showAllLog = false; S.tab = 'uebersicht'; go('detail', id); break;
    case 'new': startForm(null, { status: S.lf === 'leads' ? 'Lead: Neu' : 'Kunde' }, 'manuell', [], null); break;
    case 'edit': startForm(id, byId(id), 'manuell', [], null); break;
    case 'cancelform': S.formLead = false; S.draft = null; go(S.formId ? 'detail' : 'list', S.formId || undefined); break;
    case 'asnew': { const ex = S.extracted; if (ex) startFormReplace(ex); break; }
    case 'save': saveForm(); break;
    case 'del': if (await ask('Diesen Kunden mit allen Aufgaben, Dokumenten und dem Verlauf löschen?', 'Löschen')) { try { await removeCustomer(id); await docsDeleteCustomer(id); toast('Kunde gelöscht'); go('list'); } catch (er) { toast(dbErr(er)); } } break;
    case 'logall': S.showAllLog = true; render(); break;
    case 'taskadd': {
      const ti = $('#tt'), di = $('#td'); const titel = (ti.value || '').trim();
      if (!titel) { toast('Bitte einen Titel eingeben.'); ti.focus(); break; }
      ti.value = ''; const faellig = di.value || ''; di.value = '';
      await mutate(id, c => { c.aufgaben.push({ id: uid(), titel, faellig, erledigt: false, ts: Date.now() }); c.verlauf.push({ ts: Date.now(), text: `Aufgabe angelegt: ${titel}` }); });
      break;
    }
    case 'tasktoggle': await mutate(id, c => { const k = c.aufgaben.find(x => x.id === t.dataset.tid); if (k) { k.erledigt = !k.erledigt; k.ts = Date.now(); c.verlauf.push({ ts: Date.now(), text: `Aufgabe ${k.erledigt ? 'erledigt' : 'wieder geöffnet'}: ${k.titel}` }); } }); break;
    case 'taskdel': await mutate(id, c => { const k = c.aufgaben.find(x => x.id === t.dataset.tid); c.aufgaben = c.aufgaben.filter(x => x.id !== t.dataset.tid); if (k) c.verlauf.push({ ts: Date.now(), text: `Aufgabe gelöscht: ${k.titel}` }); }); break;
    case 'tasktab': S.taskTab = t.dataset.v; render(); break;
    case 'lf': S.lf = t.dataset.v; render(); break;
    case 'leadpaste': startLeadPaste(); break;
    case 'goalset': setGoal(); break;
    case 'stage': await mutate(S.selId, c => { const old = c.status || 'Kunde'; c.status = t.dataset.to; c.verlauf.push({ ts: Date.now(), text: `Status: „${old}“ → „${c.status}“` }); }); break;
    case 'lead2cust': await mutate(S.selId, c => { const old = c.status || 'Kunde'; c.status = 'Kunde'; c.verlauf.push({ ts: Date.now(), text: `Status: „${old}“ → „Kunde“` }); }); toast('Zum Kunden gemacht'); break;
    case 'followup': await mutate(S.selId, c => { c.aufgaben.push({ id: uid(), titel: 'Nachfassen', faellig: toIso(new Date(Date.now() + 7 * 864e5)), erledigt: false, ts: Date.now() }); c.verlauf.push({ ts: Date.now(), text: 'Aufgabe angelegt: Nachfassen' }); }); toast('Aufgabe in 7 Tagen angelegt'); break;
    case 'evtab': S.ev.tab = t.dataset.v; render(); break;
    case 'evsel': S.ev.ins = t.dataset.k; render(); window.scrollTo(0, 0); break;
    case 'evcsv': { const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"', rows = insRows(S.ev.ins); saveFile(`fintra-${String(providerNames().get(S.ev.ins) || 'anbieter').replace(/\W+/g, '-')}-${today()}.csv`, '\ufeff' + [['Kunde', 'Bereich', 'Produkt', 'Prämie/Einzahlung pro Jahr', 'Läuft ab', 'Kündigung bis'], ...rows.map(x => [fullName(x.c), x.bereich, x.produkt, Math.round(x.pj), fmtDate(x.ablauf), fmtDate(x.kbis)])].map(r => r.map(q).join(';')).join('\r\n'), 'text/csv;charset=utf-8'); break; }
    case 'segopen': S.seg = t.dataset.k; go('segment'); break;
    case 'segback': S.seg = null; go('eval'); break;
    case 'segmail': S.mail.seg = S.seg; S.ev.tab = 'serienbrief'; go('eval'); break;
    case 'segmail0': S.ev.tab = 'serienbrief'; go('eval'); break;
    case 'segcsv': saveFile(`fintra-${S.seg.replace(/\W+/g, '-')}-${today()}.csv`, custCsv(segCustomers(S.seg)), 'text/csv;charset=utf-8'); break;
    case 'phins': insertPh(t.dataset.p); break;
    case 'tplsave': saveTpl(); break;
    case 'tpldel': delTpl(); break;
    case 'mailgo': if (!S.mail.body.trim()) { toast('Bitte einen Text eingeben.'); break; } go('mailsend'); break;
    case 'mailback': go('eval'); break;
    case 'mailreset': S.mail.sent = {}; render(); break;
    case 'mprev': { const c = byId(id); if (c) viewText(fillTpl(S.mail.subject, c).text || 'Vorschau', fillTpl(S.mail.body, c).text); break; }
    case 'mmail': mailOne(id, 'Mail'); break;
    case 'mwa': mailOne(id, 'WhatsApp'); break;
    case 'mailprintall': printAllLetters(); break;
    case 'pickcsv': { const f = $('#fcsv'); if (f) f.click(); break; }
    case 'impback': S.imp = null; go('more'); break;
    case 'impgo': runImport(); break;
    case 'savesig': ls.set(SIG, ($('#sig').value || '').trim()); toast('Signatur gespeichert'); break;
    case 'dtab': S.tab = t.dataset.v; S.showAllLog = false; render(); scrollToTabs(); break;
    case 'itemnew': startItem(t.dataset.cat, t.dataset.cid, null); break;
    case 'itemedit': startItem(t.dataset.cat, t.dataset.cid, t.dataset.id || null); break;
    case 'itemcancel': cancelItem(); break;
    case 'itemsave': saveItem(); break;
    case 'itemdel': deleteItem(); break;
    case 'itemstop': if (S.ctl) S.ctl.abort(); break;
    case 'itemreread': itemReread(); break;
    case 'dcam': { const f = $('#dcamf'); if (f) f.click(); break; }
    case 'dfile': { const f = $('#dfilef'); if (f) f.click(); break; }
    case 'tcam': { const f = $('#tcamf'); if (f) f.click(); break; }
    case 'tfile': { const f = $('#tfilef'); if (f) f.click(); break; }
    case 'docview': viewDoc(id); break;
    case 'docshare': shareDocs([id]); break;
    case 'docrename': renameDoc(id); break;
    case 'docdel': deleteDoc(id); break;
    case 'docsel': S.sel[id] = !S.sel[id]; render(); break;
    case 'docselall': { const ids = S.docs.filter(d => d.cid === S.selId).map(d => d.id), all = ids.every(x => S.sel[x]); ids.forEach(x => { S.sel[x] = !all; }); render(); break; }
    case 'docsend': { const ids = S.docs.filter(d => d.cid === S.selId && S.sel[d.id]).map(d => d.id); if (ids.length) shareDocs(ids); break; }
    case 'exzip': exportZip(); break;
    case 'letter': saveItem({ letter: true }); break;
    case 'letterdirect': startLetter(t.dataset.cat, t.dataset.cid, t.dataset.id || null); break;
    case 'lback': S.letter = null; go('detail'); break;
    case 'lshare': shareText('Kündigung', S.letter.text); break;
    case 'lcopy': copyText(S.letter.text); break;
    case 'lprint': { $('#printarea').textContent = S.letter.text; window.print(); break; }
    case 'lnote': { const L = S.letter; await mutate(L.cid, c => c.verlauf.push({ ts: Date.now(), text: `Kündigung erstellt: ${L.what}${L.per ? ' per ' + L.per : ''}` })); toast('Im Verlauf notiert'); break; }
    case 'cmpshare': { const c = byId(t.dataset.cid); if (c && c.kk) shareText('Prämienvergleich', cmpText(c)); break; }
    case 'pickcam': $('#fcam').click(); break;
    case 'pickgal': $('#fgal').click(); break;
    case 'photorm': { const p = S.photos.splice(+t.dataset.i, 1)[0]; if (p) URL.revokeObjectURL(p.url); render(); break; }
    case 'photorun': runPhoto(); break;
    case 'photostop': if (S.ctl) S.ctl.abort(); break;
    case 'exjson': saveFile(`fintra-backup-${today()}.json`, JSON.stringify({ app: 'fintra', version: 1, exportiert: new Date().toISOString(), kunden: S.customers }, null, 1), 'application/json'); render(); break;
    case 'savekey': { const v = ($('#key').value || '').trim(); if (!/^sk-ant-/.test(v)) { toast('Das sieht nicht wie ein Anthropic-Schlüssel aus (beginnt mit sk-ant-).'); break; } ls.set(KEY, v); toast('Schlüssel gespeichert'); render(); break; }
    case 'delkey': ls.del(KEY); toast('Schlüssel entfernt'); render(); break;
    case 'install': if (S.installEv) { S.installEv.prompt(); S.installEv = null; render(); } break;
    case 'excsv': saveFile(`fintra-kunden-${today()}.csv`, csv(), 'text/csv;charset=utf-8'); break;
    case 'pickimp': $('#fimp').click(); break;
  }
});
function startFormReplace(ex) { S.formId = null; S.matchId = null; S.draft = clone(ex.data); S.unsicher = ex.uns; render(); window.scrollTo(0, 0); }

document.addEventListener('change', async e => {
  const id = e.target.id, fs = () => { const a = [...(e.target.files || [])]; e.target.value = ''; return a; };
  if (id === 'mtpl') { const tp = allTpls().find(x => x.id === e.target.value); S.mail.tpl = e.target.value; S.mail.cur = null; if (tp) { S.mail.subject = tp.subject; S.mail.body = tp.body; } else { S.mail.subject = ''; S.mail.body = ''; } render(); return; }
  if (id === 'mseg') { S.mail.seg = e.target.value; render(); return; }
  if (id === 'evins') { S.ev.ins = e.target.value; render(); return; }
  if (id === 'fcsv') { const f = fs()[0]; if (f) startImport(await readTextSmart(f)); return; }
  if (S.imp && id.startsWith('imp_')) { const k = id.slice(4); if (k === 'lead') S.imp.asLead = e.target.checked; else if (k === 'dup') S.imp.skipDup = e.target.checked; else S.imp.map[k] = +e.target.value; return; }
  if (id === 'fimp') { const f = fs()[0]; if (f) importFile(f); }
  else if (id === 'dcamf' || id === 'dfilef') itemAddFiles(fs());
  else if (id === 'tcamf' || id === 'tfilef') {
    const files = fs(), c = byId(S.selId); if (!c || !files.length) return;
    const added = await addDocs(files, c.id, ownerOf('kunde', null));
    if (added.length) { await mutate(c.id, x => x.verlauf.push({ ts: Date.now(), text: `${added.length} ${added.length === 1 ? 'Dokument' : 'Dokumente'} hinzugefügt (Allgemein)` })); toast('Dokument gespeichert'); }
  } else if (id === 'autof' && S.item) { S.item.auto = e.target.checked; ls.set(AUTO, e.target.checked ? '1' : '0'); }
});
document.addEventListener('focusout', e => { if (e.target.id === 'mbody' && S.mail) S.mail.cur = [e.target.selectionStart, e.target.selectionEnd]; });
document.addEventListener('input', e => {
  if (e.target.id === 'ltxt' && S.letter) S.letter.text = e.target.value;
  if (e.target.id === 'msub') S.mail.subject = e.target.value;
  if (e.target.id === 'mbody') S.mail.body = e.target.value;
  if (e.target.id === 'q') {
    S.q = e.target.value;
    const r = $('#rows'), c = $('#cnt');
    if (r) r.innerHTML = rowsHtml();
    if (c) c.textContent = `${filtered().length} von ${S.customers.length} Kunden`;
  }
});

/* ---------- Start ---------- */
async function init() {
  try { history.replaceState({ view: 'list' }, ''); } catch (e) {}
  try { S.customers = JSON.parse(ls.get(LS) || '[]').map(normC); } catch (e) { S.customers = []; }
  S.ready = true; render();
  docLoadMeta().then(m => { S.docs = m; render(); }).catch(() => {});
  window.addEventListener('resize', () => { const hd = document.querySelector('header.top'); if (hd) document.documentElement.style.setProperty('--hh', hd.offsetHeight + 'px'); });
  try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch (e) {}
  window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); S.installEv = e; if (S.view === 'more') render(); });
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {});
}
init();
})();
