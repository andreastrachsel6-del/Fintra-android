  if (it.unsicher.length) h += `<div class="note warn">Orange markierte Felder waren nicht sicher lesbar. Bitte prüfen.</div>`;
  for (const f of sc.fields) h += field(f, it.draft, it.unsicher);
  if (canLetter) h += `<button class="btn ghost block" data-act="letter">Speichern und Kündigung erstellen</button>`;
  if (!isNew) h += `<section class="sec"><button class="btn danger" data-act="itemdel">${esc(sc.title)} löschen</button></section>`;
  return h + `<div class="formbar"><div class="wrap"><button class="btn ghost" data-act="itemcancel">Abbrechen</button><button class="btn" data-act="itemsave">Speichern</button></div></div>`;
