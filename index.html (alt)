      <input id="dcamf" type="file" accept="image/*" capture="environment" hidden><input id="dfilef" type="file" accept="image/*,application/pdf" multiple hidden>`;
    if (hasKey()) h += `<label class="chk"><input type="checkbox" id="autof" ${it.auto ? 'checked' : ''}><span>Felder automatisch aus dem Dokument ausfüllen</span></label>${docs.length ? `<button class="btn quiet" data-act="itemreread">Felder aus den gespeicherten Dokumenten neu ausfüllen</button>` : ''}`;
